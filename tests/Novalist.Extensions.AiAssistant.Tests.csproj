<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FakeCli/**/*.cs" />
    <ProjectReference Include="FakeCli/Novalist.FakeAiCli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Novalist.Extensions.AiAssistant.csproj" AdditionalProperties="SkipExtensionDeploy=true" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyFakeCli" AfterTargets="Build">
    <ItemGroup>
      <FakeCliFiles Include="$(MSBuildThisFileDirectory)FakeCli/bin/$(Configuration)/net10.0/Novalist.FakeAiCli.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeCliFiles)" DestinationFolder="$(OutDir)fake-cli" />
  </Target>
</Project>
