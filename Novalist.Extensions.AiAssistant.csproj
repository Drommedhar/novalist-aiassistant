<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="extension.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Locales\*.json" CopyToOutputDirectory="PreserveNewest" Link="Locales\%(Filename)%(Extension)" />
    <Content Include="web\*.html" CopyToOutputDirectory="PreserveNewest" Link="web\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Use local Sdk for development. CI/release builds use the NuGet package instead (see Directory.Build.props or pass /p:UseLocalSdk=false). -->
  <ItemGroup Condition="'$(UseLocalSdk)' != 'false'">
    <ProjectReference Include="..\novalist-official\Novalist.Sdk\Novalist.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSdk)' == 'false'">
    <PackageReference Include="Novalist.Sdk" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <Target Name="DeployExtension" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <ExtensionDeployDir>$(APPDATA)\Novalist\Extensions\AiAssistant</ExtensionDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(ExtensionDeployDir)\Locales" />
    <MakeDir Directories="$(ExtensionDeployDir)\web" />
    <Copy SourceFiles="$(OutputPath)Novalist.Extensions.AiAssistant.dll;$(OutputPath)extension.json"
          DestinationFolder="$(ExtensionDeployDir)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_LocaleFiles Include="$(OutputPath)Locales\*.*" />
      <_WebFiles Include="$(OutputPath)web\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LocaleFiles)"
          DestinationFolder="$(ExtensionDeployDir)\Locales"
          SkipUnchangedFiles="true" />
    <!-- The webview views (chat, character chat, story analysis) are served from
         here; without this copy they 404 at novalist-ext://.../web/*.html. -->
    <Copy SourceFiles="@(_WebFiles)"
          DestinationFolder="$(ExtensionDeployDir)\web"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DeployExtensionMac" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <PropertyGroup>
      <ExtensionDeployDir>$(HOME)/Library/Application Support/Novalist/Extensions/AiAssistant</ExtensionDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(ExtensionDeployDir)/Locales" />
    <MakeDir Directories="$(ExtensionDeployDir)/web" />
    <Copy SourceFiles="$(OutputPath)Novalist.Extensions.AiAssistant.dll;$(OutputPath)extension.json"
          DestinationFolder="$(ExtensionDeployDir)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_LocaleFilesMac Include="$(OutputPath)Locales/*.*" />
      <_WebFilesMac Include="$(OutputPath)web/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LocaleFilesMac)"
          DestinationFolder="$(ExtensionDeployDir)/Locales"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WebFilesMac)"
          DestinationFolder="$(ExtensionDeployDir)/web"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
